"nome": "Camiseta Oversized Street",
"descricao": "Camiseta 100% algodão com modelagem larga.",
"categoria": "Camisetas",
"tamanho": "G",
"cor": "Preto",
"sku": "URB-TSH-001",
"qtd": 50,
"estoque_min": 10,
"custo": 45.00,
"venda": 99.90,
"id_fornecedor": 1,
"data_entrada": "2026-04-01"
}

